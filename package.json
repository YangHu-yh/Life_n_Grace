{
  "name": "life-n-grace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "prisma:generate": "prisma generate --schema prisma/main/schema.prisma && prisma generate --schema prisma/journal/schema.prisma",
    "prisma:migrate:main": "prisma migrate dev --schema prisma/main/schema.prisma",
    "prisma:migrate:journal": "prisma migrate dev --schema prisma/journal/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.2.4",
    "next": "^15.5.20",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.30",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.20",
    "prisma": "^5.18.0",
    "typescript": "^5.4.5"
  }
}
