generator client {
  provider      = "prisma-client-js"
  output        = "../../generated/main"
  // native for local dev; linux-musl-openssl-3.0.x for the Alpine Lambda image
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("MAIN_DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  displayName   String?
  passwordHash  String? // nullable — OAuth users have no password
  image         String? // OAuth profile photo
  isPro         Boolean   @default(false)
  companionMessageCount Int @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  prayerRequests   PrayerRequest[]
  reminderSettings ReminderSetting[]
  habitCheckins    HabitCheckin[]
}

// Auth.js (NextAuth v5) adapter models — populated in Phase B of the auth
// overhaul (Google OAuth); present now so prisma db push prepares the DB.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PrayerRequest {
  id        String       @id @default(cuid())
  userId    String
  topic     String
  notes     String?
  stage     PrayerStage  @default(SEED)
  lane      PrayerLane   @default(ACTIVE)
  prayerCount Int        @default(0)
  lastPrayedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lane, createdAt(sort: Desc)])
}

model ReminderSetting {
  id        String   @id @default(cuid())
  userId    String
  channel   String
  time      String
  timezone  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HabitCheckin {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

enum PrayerStage {
  SEED
  SPROUT
  BLOOM
}

enum PrayerLane {
  ACTIVE
  ACCOMPLISHED
  REROUTED
  PRAISE
}
