MAIN_DATABASE_URL="postgresql://lifeuser:lifepass@localhost:5432/life_n_grace_main"
JOURNAL_DATABASE_URL="postgresql://lifeuser:lifepass@localhost:5432/life_n_grace_journal"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_JWT_SECRET="replace-with-strong-random-string"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOURNAL_ENCRYPTION_KEY="replace-with-64-char-hex-string"

# Email delivery (optional until launch — when unset, signups are
# auto-verified and verification emails are skipped)
# RESEND_API_KEY="re_your_resend_key"        # dev/staging
# EMAIL_PROVIDER="ses"                        # production (uses AWS SES)
# EMAIL_FROM="Life-n-Grace <noreply@lifengrace.com>"
#
# SMTP provider (e.g. a Gmail address for temporary testing — create an app
# password at myaccount.google.com/apppasswords). Takes effect when HOST,
# USER, and PASS are all set and EMAIL_PROVIDER is not "ses". Swapping to the
# formal address later is config-only: change EMAIL_FROM + these credentials
# (or switch to EMAIL_PROVIDER="ses") — no code changes. See DEPLOYMENT.md
# "Changing the sender email".
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your.temp.address@gmail.com"
# SMTP_PASS="your-16-char-app-password"

# Google sign-in (optional — the "Continue with Google" button appears
# automatically when both are set; redirect URI to register in Google Cloud
# Console: <origin>/api/auth/google/callback)
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-client-secret"

# Companion AI — Apologist Fusion (OpenAI-compatible endpoint)
APOLOGIST_API_KEY="replace-with-your-key"
APOLOGIST_API_URL="https://your-agent-domain/api/v1"
APOLOGIST_MODEL_ID="gpt-4o"
APOLOGIST_TRANSLATION="esv"

# Per-user daily cap on AI generations (companion chat + topic prayers share
# one budget). Positive integer; unset/invalid falls back to 10.
# AI_DAILY_LIMIT="10"
